{
  "name": "agentic-fm",
  "displayName": "Agentic FM",
  "description": "FileMaker script & calculation language support: syntax highlighting, step/function completions, live linting, and context sync via the agentic-fm plugin.",
  "version": "0.1.29",
  "publisher": "agentic-fm",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:agenticfm.contextView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agenticfm-sidebar",
          "title": "FM Context",
          "icon": "./fm.svg"
        }
      ]
    },
    "views": {
      "agenticfm-sidebar": [
        {
          "type": "webview",
          "id": "agenticfm.contextView",
          "name": "FM Context"
        }
      ]
    },
    "languages": [
      {
        "id": "fmscript",
        "aliases": ["FileMaker Script", "fmscript"],
        "extensions": [".fmscript"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "fmcalc",
        "aliases": ["FileMaker Calculation", "fmcalc", "fmfn"],
        "extensions": [".fmfn"],
        "configuration": "./fmcalc-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fmscript",
        "scopeName": "source.fmscript",
        "path": "./syntaxes/fmscript.tmLanguage.json"
      },
      {
        "language": "fmcalc",
        "scopeName": "source.fmcalc",
        "path": "./syntaxes/fmcalc.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "agenticfm.syncContext",
        "title": "Agentic-fm: Sync Context"
      },
      {
        "command": "agenticfm.deployScript",
        "title": "Agentic-fm: Deploy Script"
      },
      {
        "command": "agenticfm.fetchScript",
        "title": "Agentic-fm: Fetch Script"
      }
    ]
  }
}
