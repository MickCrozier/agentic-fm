{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FileMaker Script",
  "scopeName": "source.fmscript",
  "fileTypes": ["fmscript"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#step_line" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.number-sign.fmscript",
      "match": "^\\s*#.*$"
    },

    "step_line": {
      "begin": "^(\\s*)",
      "end": "$",
      "patterns": [
        { "include": "#control_step" },
        { "include": "#step_name" },
        { "include": "#param_block" }
      ]
    },

    "control_step": {
      "match": "\\G(Else If|If|Else|End If|End Loop|End While|Exit Loop If|Exit Script|Halt Script|Loop|While)(?=\\s*[\\[\\n]|\\s*$)",
      "captures": {
        "1": { "name": "keyword.control.fmscript" }
      }
    },

    "step_name": {
      "match": "\\G([A-Za-z][^\\[\\n]*?)\\s*(?=\\[|$)",
      "captures": {
        "1": { "name": "keyword.other.step.fmscript" }
      }
    },

    "param_block": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": { "0": { "name": "punctuation.section.bracket.begin.fmscript" } },
      "endCaptures":   { "0": { "name": "punctuation.section.bracket.end.fmscript" } },
      "patterns": [
        { "include": "#string" },
        { "include": "#variable_global" },
        { "include": "#variable_local" },
        { "include": "#field_ref" },
        { "include": "#get_function" },
        { "include": "#function" },
        { "include": "#number" },
        { "include": "#constant" },
        { "include": "#operator" },
        { "include": "#label" },
        { "include": "#param_block" }
      ]
    },

    "string": {
      "name": "string.quoted.double.fmscript",
      "begin": "\"",
      "end": "\""
    },

    "variable_global": {
      "match": "\\$\\$[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.global.fmscript"
    },

    "variable_local": {
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*",
      "name": "variable.other.local.fmscript"
    },

    "field_ref": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)(::)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "entity.name.type.table.fmscript" },
        "2": { "name": "punctuation.separator.field.fmscript" },
        "3": { "name": "variable.other.member.fmscript" }
      }
    },

    "get_function": {
      "begin": "\\b(Get)\\s*(\\()",
      "end": "(\\))",
      "beginCaptures": {
        "1": { "name": "support.function.builtin.fmscript" },
        "2": { "name": "punctuation.definition.parameters.begin.fmscript" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.parameters.end.fmscript" }
      },
      "patterns": [
        { "match": "[A-Za-z][A-Za-z0-9]*", "name": "constant.language.get-parameter.fmscript" }
      ]
    },

    "function": {
      "match": "\\b([A-Z][A-Za-z0-9]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "support.function.builtin.fmscript" }
      }
    },

    "number": {
      "match": "(?<![A-Za-z_$])-?\\d+(\\.\\d+)?\\b",
      "name": "constant.numeric.fmscript"
    },

    "constant": {
      "match": "\\b(True|False|JSONBoolean|JSONString|JSONNumber|JSONArray|JSONObject|JSONNull|On|Off)\\b",
      "name": "constant.language.fmscript"
    },

    "operator": {
      "match": "(≠|≥|≤|>=|<=|<>|[=<>&]|\\b(?:and|or|not|xor)\\b)",
      "name": "keyword.operator.fmscript"
    },

    "label": {
      "match": "\\b([A-Za-z][A-Za-z0-9 ]*)(:)(?!:)",
      "captures": {
        "1": { "name": "entity.name.label.fmscript" },
        "2": { "name": "punctuation.separator.label.fmscript" }
      }
    }

  }
}
