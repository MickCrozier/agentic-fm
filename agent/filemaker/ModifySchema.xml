<?xml version="1.0"?>
<fmxmlsnippet type="FMObjectList">
  <Script includeInMenu="False" SiriShortcutVisible="False" runFullAccess="False" id="13" name="ModifySchema">
    <Step enable="True" id="89" name="# (comment)"/>
    <Step enable="True" id="89" name="# (comment)">
      <Text>Used by external Agentic-fm agent to modify the schema</Text>
    </Step>
    <Step enable="True" id="89" name="# (comment)"/>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[Get(ScriptParameter)]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$ScriptParameter</Name>
    </Step>
    <Step enable="True" id="89" name="# (comment)"/>
    <Step enable="True" id="89" name="# (comment)">
      <Text>Prevent SQL modifying data</Text>
    </Step>
    <Step enable="True" id="68" name="If">
      <Restore state="False"/>
      <Calculation><![CDATA[PatternCount ($ScriptParameter; "INSERT") > 0 or
PatternCount ($ScriptParameter; "DELETE") > 0 or
PatternCount ($ScriptParameter; "UPDATE") > 0]]></Calculation>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA["You can not modify data"]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="89" name="# (comment)"/>
    <Step enable="True" id="68" name="If">
      <Restore state="False"/>
      <Calculation><![CDATA[PatternCount ($ScriptParameter; "DROP") > 0]]></Calculation>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA["You can not drop tables or fields"]]></Calculation>
    </Step>
    <Step enable="True" id="70" name="End If"/>
    <Step enable="True" id="89" name="# (comment)"/>
    <Step enable="True" id="141" name="Set Variable">
      <Value>
        <Calculation><![CDATA[BE_FileMakerSQL ( Get(ScriptParameter) )]]></Calculation>
      </Value>
      <Repetition>
        <Calculation><![CDATA[1]]></Calculation>
      </Repetition>
      <Name>$sql</Name>
    </Step>
    <Step enable="True" id="103" name="Exit Script">
      <Calculation><![CDATA[BE_GetLastDDLError]]></Calculation>
    </Step>
  </Script>
</fmxmlsnippet>
