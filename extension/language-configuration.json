{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(If|Loop|While)\\b",
      "end": "^\\s*(End If|End Loop|End While)\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(If|Else( If)?|Loop|While)\\b",
    "decreaseIndentPattern": "^\\s*(Else( If)?|End If|End Loop|End While)\\b"
  }
}
