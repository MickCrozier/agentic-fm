{
  "name": "agentic-fm",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bullseye",

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/rust:1": {}
  },

  "updateRemoteUserUID": true,

  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached"
  ],

  "postCreateCommand": "bash .devcontainer/postCreate.sh",
  "postStartCommand": "bash .devcontainer/postStart.sh",

  "portsAttributes": {
    "8765": {
      "label": "agentic-fm companion server",
      "onAutoForward": "ignore"
    },
    "8080": {
      "label": "agentic-fm web server",
      "onAutoForward": "ignore"
    },
    "8081": {
      "label": "agentic-fm layout editor",
      "onAutoForward": "ignore"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint",
        "anthropic.claude-code",
        "jwillinghalpern.filemaker-vscode"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "terminal.integrated.defaultProfile.linux": "bash",
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions"
            
      }
    }
  },


  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "PATH": "${containerEnv:PATH}:/home/vscode/bin",
    "CLIPBOARD_SERVER_URL": "http://host.docker.internal:8766"
  }
}
